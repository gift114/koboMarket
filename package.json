{
  "name": "kobomarket",
  "version": "0.1.0",
  "description": "KoboMarket - multi-vendor marketplace with wallets and escrow (Node.js, Express, MongoDB, PostgreSQL)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "migrate:make": "knex --knexfile knexfile.js migrate:make",
    "seed": "node src/db/seeds/index.js",
    "create-admin": "node scripts/create-admin.js",
    "audit:ledger": "node scripts/audit-ledger.js",
    "test": "jest --runInBand --forceExit",
    "test:memory": "cross-env TEST_BACKEND=memory jest --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/tests/global-setup.js",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mongoose": "^8.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.2",
    "supertest": "^7.0.0"
  }
}
