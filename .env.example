# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Databases ----
# MongoDB: users, vendors, products, carts, reviews, notifications
MONGO_URI=mongodb://mongo:27017/kobomarket
# PostgreSQL: wallets, ledger, orders, escrow, payouts, disputes
DATABASE_URL=postgres://kobo:kobo_password@postgres:5432/kobomarket

# Tests run against their own database (created and rebuilt automatically by `npm test`).
TEST_DATABASE_URL=postgres://kobo:kobo_password@localhost:5432/kobomarket_test

# ---- Auth (generate a long random value, never commit the real one) ----
# Signs the 15-minute access tokens. Refresh tokens are random opaque strings stored hashed
# in MongoDB, so they need no signing secret.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# bcrypt cost factor (12 is a sensible production default)
BCRYPT_ROUNDS=12

# ---- Email ----
# console = print emails (including verification/reset tokens) to the API's stdout. Fine for
#           development and the demo; use smtp (e.g. Mailtrap) for anything real.
# smtp    = send through SMTP_* below
MAIL_TRANSPORT=console
MAIL_FROM=KoboMarket <no-reply@kobomarket.local>
APP_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Login rate limit (per email + IP) ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- General API rate limit (per IP) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
# Stricter per-IP limit on register / forgot-password / reset-password / resend-verification
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# ---- Business rules (all money values are integer kobo, 100 kobo = N1) ----
# Commission in basis points: 500 = 5.00%. Admin can change it at runtime later.
COMMISSION_RATE_BPS=500
ESCROW_AUTO_COMPLETE_HOURS=72
PAYOUT_MINIMUM_KOBO=100000

# ---- Payment provider: "mock" or "paystack" ----
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
