# ---- App ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Databases ----
# MongoDB: users, vendors, products, carts, reviews, notifications
MONGO_URI=mongodb://mongo:27017/kobomarket
# PostgreSQL: wallets, ledger, orders, escrow, payouts, disputes
DATABASE_URL=postgres://kobo:kobo_password@postgres:5432/kobomarket

# ---- Auth (generate long random values, never commit real ones) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# ---- Login rate limit (per email + IP) ----
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ---- General API rate limit (per IP) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# ---- Business rules (all money values are integer kobo, 100 kobo = N1) ----
# Commission in basis points: 500 = 5.00%. Admin can change it at runtime later.
COMMISSION_RATE_BPS=500
ESCROW_AUTO_COMPLETE_HOURS=72
PAYOUT_MINIMUM_KOBO=100000

# ---- Payment provider: "mock" or "paystack" ----
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
